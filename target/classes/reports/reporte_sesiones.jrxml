<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
 "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              name="reporte_sesiones" pageWidth="842" pageHeight="595"
              orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20">
  <parameter name="TITULO" class="java.lang.String"/>
  <parameter name="FECHA_INICIO" class="java.lang.String"/>
  <parameter name="FECHA_FIN" class="java.lang.String"/>
  <parameter name="TOTAL" class="java.lang.Double"/>
  <field name="fecha" class="java.lang.String"/>
  <field name="paciente" class="java.lang.String"/>
  <field name="fisioterapeuta" class="java.lang.String"/>
  <field name="terapia" class="java.lang.String"/>
  <field name="monto" class="java.lang.Double"/>
  <field name="observaciones" class="java.lang.String"/>
  <title>
    <band height="70">
      <staticText>
        <reportElement x="0" y="0" width="782" height="30"/>
        <textElement textAlignment="Center">
          <font fontName="SansSerif" size="16" isBold="true"/>
        </textElement>
        <text><![CDATA[FisioSalud S.A.C.]]></text>
      </staticText>
      <textField>
        <reportElement x="0" y="30" width="782" height="20"/>
        <textElement textAlignment="Center"><font fontName="SansSerif" size="12" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$P{TITULO}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="0" y="50" width="782" height="18"/>
        <textElement textAlignment="Center"><font fontName="SansSerif" size="10"/></textElement>
        <textFieldExpression><![CDATA["Período: " + $P{FECHA_INICIO} + " al " + $P{FECHA_FIN}]]></textFieldExpression>
      </textField>
    </band>
  </title>
  <columnHeader>
    <band height="25">
      <staticText><reportElement x="0" y="0" width="80" height="25" backcolor="#1a5276" mode="Opaque"/>
        <textElement textAlignment="Center"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
        <text><![CDATA[Fecha]]></text></staticText>
      <staticText><reportElement x="80" y="0" width="150" height="25" backcolor="#1a5276" mode="Opaque"/>
        <textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement>
        <text><![CDATA[Paciente]]></text></staticText>
      <staticText><reportElement x="230" y="0" width="150" height="25" backcolor="#1a5276" mode="Opaque"/>
        <textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement>
        <text><![CDATA[Fisioterapeuta]]></text></staticText>
      <staticText><reportElement x="380" y="0" width="120" height="25" backcolor="#1a5276" mode="Opaque"/>
        <textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement>
        <text><![CDATA[Tipo de Terapia]]></text></staticText>
      <staticText><reportElement x="500" y="0" width="80" height="25" backcolor="#1a5276" mode="Opaque"/>
        <textElement textAlignment="Right"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
        <text><![CDATA[Monto S/.]]></text></staticText>
      <staticText><reportElement x="580" y="0" width="202" height="25" backcolor="#1a5276" mode="Opaque"/>
        <textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement>
        <text><![CDATA[Observaciones]]></text></staticText>
    </band>
  </columnHeader>
  <detail>
    <band height="20">
      <textField><reportElement x="0" y="0" width="80" height="20"/>
        <textElement textAlignment="Center"><font fontName="SansSerif" size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression></textField>
      <textField><reportElement x="80" y="0" width="150" height="20"/>
        <textElement><font fontName="SansSerif" size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{paciente}]]></textFieldExpression></textField>
      <textField><reportElement x="230" y="0" width="150" height="20"/>
        <textElement><font fontName="SansSerif" size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{fisioterapeuta}]]></textFieldExpression></textField>
      <textField><reportElement x="380" y="0" width="120" height="20"/>
        <textElement><font fontName="SansSerif" size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{terapia}]]></textFieldExpression></textField>
      <textField><reportElement x="500" y="0" width="80" height="20"/>
        <textElement textAlignment="Right"><font fontName="SansSerif" size="8"/></textElement>
        <textFieldExpression><![CDATA[String.format("%.2f", $F{monto})]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="580" y="0" width="202" height="20"/>
        <textElement><font fontName="SansSerif" size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{observaciones} != null ? $F{observaciones}.substring(0, Math.min($F{observaciones}.length(), 60)) : ""]]></textFieldExpression></textField>
    </band>
  </detail>
  <summary>
    <band height="30">
      <staticText><reportElement x="380" y="5" width="120" height="20"/>
        <textElement textAlignment="Right"><font fontName="SansSerif" size="10" isBold="true"/></textElement>
        <text><![CDATA[TOTAL:]]></text></staticText>
      <textField><reportElement x="500" y="5" width="80" height="20"/>
        <textElement textAlignment="Right"><font fontName="SansSerif" size="10" isBold="true"/></textElement>
        <textFieldExpression><![CDATA["S/. " + String.format("%.2f", $P{TOTAL})]]></textFieldExpression></textField>
    </band>
  </summary>
</jasperReport>
